* text=auto

# Byte-identity-protected files: NEVER EOL-normalize (audit SEC-1, ADR-0256). The CUI guard's
# inherited_from_main rule requires staged blobs byte-identical to origin/main, and the installer
# lockstep test requires generated artifacts byte-identical to the committed ones — a
# renormalization pass over these would break both.
*.aft -text
*.xer -text
*.mpp -text
*.xlsx -text
*.docx -text
00_REFERENCE_INTAKE/** -text
installer/** -text
# LODESTAR (ADR-0539): the .pyz is held byte-identical to a fresh build, LODESTAR.bat keeps its
# CRLF line ends, and LODESTAR.command / lodestar.sh keep LF even on a Windows (autocrlf) checkout —
# a CRLF shebang ("#!/bin/sh\r") cannot start the macOS / Linux launcher (measured: exit 127).
lodestar/** -text
tests/fixtures/** -text

 "pkg": [
  "python -m venv .venv && . .venv/bin/activate      # (Windows: .venv\\Scripts\\Activate.ps1)",
  "From the activated venv, run the installer once to get a **Desktop icon** you double-click:",
  "the tool starts with **no console window** (it runs `pythonw.exe -m schedule_forensics`),",
  "- Portable alternative (no installer): double-click **`packaging\\windows\\Schedule Forensics.vbs`**",
  "  — works when `pythonw` is on PATH (i.e. the venv is active/installed).",
  "  `python packaging\\make_icon.py`.",
  "The shortcut runs `pythonw` (no console), so a startup failure has nowhere to print. The tool now",
  "package is no longer installed there. Re-run the installer from your venv; it re-points the icon",
  "- **Any OS (terminal):** `schedule-forensics`  (or `python -m schedule_forensics.launcher`)"
 ],
 "ci": [
  "name: CI",
  "        python-version: [\"3.11\", \"3.13\"]",
  "      - name: Set up Python ${{ matrix.python-version }}",
  "        uses: actions/setup-python@v6",
  "          python-version: ${{ matrix.python-version }}",
  "      - name: Install (package + dev toolchain)",
  "        run: |",
  "          python -m pip install --upgrade pip",
  "          python -m pip install -e '.[dev]'",
  "      - name: Lint (ruff)",
  "        run: ruff check .",
  "      - name: Format check (ruff)",
  "        run: ruff format --check .",
  "      - name: Types (mypy, strict)",
  "        run: mypy",
  "      - name: Tests + overall coverage gate (>=70%)",
  "        run: pytest --cov=schedule_forensics --cov-report=term-missing --cov-fail-under=70",
  "      - name: Engine coverage gate (>=85%)",
  "        run: coverage report --include='*/schedule_forensics/engine/*' --fail-under=85",
  "      - name: Parity gate (Acumen Fuse v8.11.0 + SSI golden, §6.B)",
  "        run: pytest -m parity -p no:cacheprovider",
  "      - name: Security (bandit)",
  "        run: bandit -q -r src",
  "      - name: Dependency audit (pip-audit)",
  "        run: pip-audit --progress-spinner=off",
  "    name: check",
  "      - run: echo \"all matrix jobs passed\""
 ],
 "smoke": [
  "# Installer smoke tests — real-OS verification of the one-file installers.",
  "# The build container is Linux, so the Windows installers could never be executed before",
  "# EXECUTES tier1 in smoke mode (temp root, prompts skipped, no Ollama/Java) — embedded wheel",
  "# .sh family plus an actual serve/stop round-trip. Triggered only when installer content",
  "name: installer-smoke",
  "      - \"installer/**\"",
  "      - \"tools/installer/**\"",
  "      - \".github/workflows/installer-smoke.yml\"",
  "      - \"installer/**\"",
  "      - \"tools/installer/**\"",
  "      - name: Enable Windows long paths for checkout",
  "        run: git config --system core.longpaths true",
  "      - name: Parse all three PowerShell installers (syntax gate)",
  "        run: |",
  "          foreach ($f in Get-ChildItem installer/install-*.ps1) {",
  "      - name: Smoke-run tier1 (embedded wheel -> venv -> import)",
  "          SF_INSTALLER_SMOKE: \"1\"",
  "        run: |",
  "          powershell -ExecutionPolicy Bypass -File installer/install-tier1.ps1",
  "          & $venvPy -c \"import schedule_forensics.web.app as a, pathlib; d = pathlib.Path(a.__file__).parent / 'static'; assert d.is_dir() and any(d.iterdir()), 'static assets missing from wheel'; print('wheel static assets OK')\"",
  "          python-version: \"3.12\"",
  "      - name: Smoke-run tier1 with only python.exe discoverable (no py launcher)",
  "          SF_INSTALLER_SMOKE: \"1\"",
  "        run: |",
  "          powershell -ExecutionPolicy Bypass -File installer/install-tier1.ps1",
  "      - name: Syntax-check the sh/command installers",
  "        run: |",
  "          for f in installer/install-*.sh installer/install-*.command; do",
  "      - name: Smoke-run tier1 end-to-end (install -> serve -> static -> stop -> uninstall)",
  "          SF_INSTALLER_SMOKE: \"1\"",
  "        run: |",
  "          bash installer/install-tier1.sh"
 ],
 "testpkg": [
  "def test_os_shortcuts_present() -> None:",
  "        \"windows/Install-Desktop-Shortcut.ps1\",  # Windows desktop-icon installer",
  "        assert (PKG / rel).is_file(), f\"missing packaging artifact: {rel}\"",
  "def test_windows_installer_targets_pythonw_launcher() -> None:",
  "    assert \"pythonw\" in ps1 and \"-m schedule_forensics\" in ps1",
  "    # so assert against the actual assignment line rather than the whole file).",
  "    assert '\"-m schedule_forensics\"' in args_line",
  "    assert \"schedule_forensics.launcher\" not in args_line  # the unguarded target is retired",
  "    assert \"Desktop\" in ps1 and \".ico\" in ps1  # creates a Desktop shortcut with the icon",
  "def test_icon_is_a_valid_multi_entry_ico() -> None:",
  "    assert reserved == 0 and kind == 1 and count == 5  # 256/128/64/32/16 entries",
  "        assert bpp == 32",
  "        assert data[offset : offset + 8] == b\"\\x89PNG\\r\\n\\x1a\\n\"  # PNG-in-ICO payload",
  "        assert size > 0 and offset + size <= len(data)",
  "    assert sizes == [256, 128, 64, 32, 16]",
  "def test_icon_generator_is_deterministic_and_all_copies_are_in_sync() -> None:",
  "    assert ico == ico2 and png == png2  # deterministic",
  "    assert (PKG / \"windows\" / \"schedule-forensics.ico\").read_bytes() == ico",
  "    assert (PKG / \"schedule-forensics.png\").read_bytes() == png",
  "    assert favicon.read_bytes() == ico  # browser tab == desktop icon"
 ]
}
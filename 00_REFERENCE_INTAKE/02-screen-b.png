/* AISMAT Command Deck — Spacing
   4px base grid. Use the numeric ramp for layout; the semantic aliases name
   the recurring roles (page padding, panel padding, gutters, stack gaps). */
:root {
  --space-px: 1px;
  --space-0: 0;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-7: 28px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-14: 56px;
  --space-16: 64px;
  --space-20: 80px;
  --space-24: 96px;
  --space-32: 128px;

  /* Semantic roles */
  --page-pad: 32px;
  --panel-pad: 20px;
  --card-pad: 16px;
  --gutter: 24px;
  --stack-gap: 16px;
  --inline-gap: 8px;
  --control-gap: 8px;
  --section-gap: 48px;

  /* Fixed chrome dimensions */
  --topbar-h: 56px;
  --rolestrip-h: 44px;
  --sidebar-w: 248px;
  --statusbar-h: 32px;
}

/* AISMAT Command Deck — Motion
   Motion explains, it never performs (DECK doctrine). Decoration never gates a
   number appearing on screen. Everything here degrades to near-zero under
   prefers-reduced-motion (block at the bottom). */
:root {
  --dur-instant: 80ms; /* @kind other */
  --dur-fast: 140ms; /* @kind other */
  --dur-base: 220ms; /* @kind other */
  --dur-slow: 400ms; /* @kind other */
  --dur-slower: 640ms; /* @kind other */
  --dur-reveal: 900ms; /* @kind other */
  --dur-pulse: 2600ms; /* @kind other */

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1); /* @kind other */
  --ease-in: cubic-bezier(0.7, 0, 0.84, 0); /* @kind other */
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1); /* @kind other */
  --ease-standard: cubic-bezier(0.2, 0, 0, 1); /* @kind other */
  --ease-emphasized: cubic-bezier(0.2, 0, 0, 1); /* @kind other */
}

/* Status-change pulse — motion is a signal, applied only when status changed. */
@keyframes aismat-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(51, 222, 205, 0.0); }
  50% { box-shadow: 0 0 0 6px rgba(51, 222, 205, 0.0), 0 0 22px rgba(51, 222, 205, 0.28); }
}

/* Trend reveal — sweep a time-series in on load. */
@keyframes aismat-trend-draw {
  from { stroke-dashoffset: var(--trend-length, 1000); }
  to { stroke-dashoffset: 0; }
}

/* Driving-path travelling highlight (dash march along critical logic). */
@keyframes aismat-path-march {
  to { stroke-dashoffset: -32; }
}

/* Console scanline drift. */
@keyframes aismat-scanline {
  from { background-position-y: 0; }
  to { background-position-y: 6px; }
}

/* Live-data cursor blink (mono readouts / air-gap chip). */
@keyframes aismat-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.25; }
}

/* Entrance for altitude transitions between Acts. */
@keyframes aismat-fade-up {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

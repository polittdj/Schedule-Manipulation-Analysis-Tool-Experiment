        "message": "<CitationChip> doesn't accept that prop. Declared props: id, confirmed, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DcmaResult'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|key|ref|className|style|children)$/]",
        "message": "<DcmaResult> doesn't accept that prop. Declared props: name, status."
      },

        "selector": "JSXOpeningElement[name.name='DcmaResult'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pass|warn|fail|na)$/]",
        "message": "<DcmaResult> status must be one of 'pass' | 'warn' | 'fail' | 'na'."
